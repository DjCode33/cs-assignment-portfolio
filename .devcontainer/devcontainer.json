{
  "name": "CS Assignment Portfolio",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": {
      "label": "Proxy",
      "visibility": "public",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "corepack pnpm install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "settings": {
        "npm.packageManager": "pnpm"
      }
    }
  }
}